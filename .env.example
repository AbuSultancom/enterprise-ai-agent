# ─── Enterprise AI Agent — Environment Configuration ─────────────────────────
# Copy this file to .env and fill in your values.
# Run: python install_check.py to validate your configuration.

# ══════════════════════════════════════════════════════════════
#  SECURITY — REQUIRED
#  Change these before going to production!
# ══════════════════════════════════════════════════════════════
ADMIN_KEY=change-me-admin-key-min-32-chars
USER_KEY=change-me-user-key-min-32-chars

# ══════════════════════════════════════════════════════════════
#  LLM PROVIDERS — Configure at least ONE
# ══════════════════════════════════════════════════════════════

# ── Ollama (Local / On-Premise — data never leaves your network) ──────────────
# OLLAMA_BASE_URL=http://localhost:11434        # default
# DEFAULT_MODEL=ollama:qwen2.5:7b              # model to use by default

# ── OpenAI ────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1    # or your proxy
# OPENAI_MODEL=gpt-4o-mini                    # fallback model
# OPENAI_EMBED_MODEL=text-embedding-3-small   # for knowledge base embeddings

# ── Anthropic Claude ──────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# DEFAULT_MODEL=anthropic:claude-3-5-sonnet-20241022

# ── Google Gemini ─────────────────────────────────────────────────────────────
# GEMINI_API_KEY=AIza...
# DEFAULT_MODEL=gemini:gemini-2.0-flash

# ── Hugging Face ─────────────────────────────────────────────────────────────
# HF_TOKEN=hf_...
# HF_BASE_URL=https://api-inference.huggingface.co

# ── Vision (Image Analysis) ───────────────────────────────────────────────────
# VISION_MODEL=gpt-4o                         # or claude-3-5-sonnet-20241022

# ══════════════════════════════════════════════════════════════
#  ACCOUNTING / ERP DATABASES
# ══════════════════════════════════════════════════════════════
# Legacy single-DB fallback (use config/accounting_schema.json for multi-DB)
# ACCOUNTING_DB_URL=mssql+pyodbc://readonly_user:password@192.168.1.10/OnyxDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ══════════════════════════════════════════════════════════════
#  COMMUNICATION CHANNELS
# ══════════════════════════════════════════════════════════════
# WHATSAPP_ENABLED=true
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ══════════════════════════════════════════════════════════════
#  EMAIL (SMTP) — for send_email_notification tool
# ══════════════════════════════════════════════════════════════
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Enterprise AI Agent <your@email.com>

# ══════════════════════════════════════════════════════════════
#  PERFORMANCE & BEHAVIOUR
# ══════════════════════════════════════════════════════════════
# CHAT_MEMORY=5                  # number of conversation turns to keep in context
# EMBED_MODEL=nomic-embed-text   # local Ollama model for embeddings

# ══════════════════════════════════════════════════════════════
#  ADVANCED / OPTIONAL
# ══════════════════════════════════════════════════════════════
# AUDIT_LOG_PATH=data/audit.jsonl    # custom audit log location
# API_KEYS=admin:your-admin-key,user:your-user-key   # override .env keys
